{
  "name": "noora-server",
  "version": "1.0.0",
  "private": true,
  "description": "TypeScript Express backend for Noora.",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/server.js",
    "dev": "tsx watch --env-file=.env src/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate:initial": "node --env-file=.env scripts/run-initial-migration.cjs",
    "db:migrate:notification-emails": "node --env-file=.env scripts/run-notification-email-migration.cjs",
    "test": "npm run typecheck"
  },
  "dependencies": {
    "@google/genai": "^2.6.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "jose": "^6.1.0",
    "kysely": "^0.28.8",
    "pg": "^8.16.3",
    "resend": "^6.12.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
